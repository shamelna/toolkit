{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "."
      }
    }
  ],
  "routes": [
    {
      "src": "/DOE-Navigator",
      "dest": "/DOE-Navigator/"
    },
    {
      "src": "/DOE-Navigator/(.*)",
      "dest": "/DOE-Navigator/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
